# deploy/accounts.env - every account the public deployment uses.
#
# Copy this file to accounts.env (git ignores it) and fill in what you need.
# An empty line means "this machine's own login": the Modal CLI's
# ~/.modal.toml, the Lightning CLI's saved login, `hf auth login`.
#
# To move the deployment onto someone else's accounts - a colleague's, when
# your credits run out - put their values here and run, from the repo root:
#
#     python deploy/bis_cloud.py modal deploy
#     python deploy/bis_cloud.py front deploy
#
# Modal names addresses after the workspace, so the public address becomes
# theirs; `front deploy` prints it and keeps it below as FRONT_URL.

# --- Modal: the judge, per call ------------------------------------------
# A profile in ~/.modal.toml (`python -m modal profile list`), or a token
# pair from modal.com > Settings > API Tokens. A pair wins over a profile.
MODAL_PROFILE=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# T4 (about $0.70 an hour all in) or L4 (about $0.95).
MODAL_GPU=T4
# One ledger counts this month's Modal spend by the judge and the front
# door. The judge refuses every call (HTTP 402) once it reaches
# BIS_BUDGET_USD; the front door stops once it reaches BIS_FRONT_BUDGET_USD,
# set higher, so the ranker still answers after the GPU is capped. Keep
# both under what is left of the month's free credit - `python -m modal
# billing summary` says what is used - and set the workspace's own budget
# in Modal's settings too: that limit Modal itself enforces.
BIS_BUDGET_USD=24.00
BIS_FRONT_BUDGET_USD=26.00
# Written by `modal deploy` and `front deploy`.
MODAL_URL=
FRONT_URL=

# --- Lightning AI: the switched fallback ---------------------------------
# lightning.ai > your profile > Settings > Keys. Empty = the saved login.
LIGHTNING_USER_ID=
LIGHTNING_API_KEY=
# The teamspace to run in (owner/teamspace); empty = your default one.
LIGHTNING_TEAMSPACE=
# `lightning on` stops itself after this many hours unless told otherwise.
LIGHTNING_HOURS=4

# --- Hugging Face: the model weights --------------------------------------
# A token that can read the private model repo the judge downloads.
HF_TOKEN=

# --- The front door's own keys (made by bis_cloud.py when empty) ----------
# The key the front door sends to every GPU backend.
BIS_BACKEND_KEY=
# The key that may change the front door's list of backends.
BIS_ADMIN_KEY=
